AGENT_MODE=mock
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=
AGENTLAB_DATA=./data
AGENTLAB_IMAGE=agentlab-runner:0.1

# Generation only: auto enables JSON mode for official DeepSeek; other endpoints
# remain prompt-only. Set json_object only for a verified compatible provider.
# prompt explicitly disables request-level JSON mode. No silent fallback.
GENERATION_JSON_MODE=auto
# Official DeepSeek generation only; token/time/request caps remain enforced.
# Thinking tokens share the existing output budget. Reports keep their own policy.
GENERATION_THINKING=disabled
GENERATION_REASONING_EFFORT=high
# 30..300 seconds per generation request; total job time remains bounded.
GENERATION_REQUEST_TIMEOUT=90
# New generation batches only: 1..4 times stage caps and default batch tokens.
# Saved batches keep their persisted multiplier (legacy batches use 1).
GENERATION_OUTPUT_MULTIPLIER=1
